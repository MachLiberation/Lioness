#!/bin/sh
# Refuses to install without Ammonia, and takes down any earlier copy of the daemon.
TWEAKS="$3/private/var/ammonia/core/tweaks"
if [ ! -d "$TWEAKS" ]; then
    echo "Lioness needs Ammonia: $TWEAKS does not exist." >&2
    exit 1
fi
if [ "$3" = "/" ]; then
    launchctl bootout system/com.lioness.setup 2>/dev/null || true
    launchctl bootout system/com.lioness.appkitd 2>/dev/null || true
    # LionessSetup.sh puts the daemon back once the root and the tweak are ready.
    rm -f /Library/LaunchDaemons/com.lioness.setup.plist /Library/LaunchDaemons/com.lioness.appkitd.plist
    # A development job of the same name in the login session would shadow the installed one.
    CONSOLE=$(stat -f%u /dev/console 2>/dev/null)
    [ -n "$CONSOLE" ] && launchctl bootout "gui/$CONSOLE/com.lioness.appkitd" 2>/dev/null || true
fi
exit 0
