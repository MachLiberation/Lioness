<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.lioness.appkitd</string>
    <key>ProgramArguments</key><array>
        <string>/Library/Lioness/appkitd</string>
        <string>/Library/Lioness/ml-root</string>
    </array>
    <key>MachServices</key><dict><key>com.lioness.appkitd</key><true/></dict>
    <!-- At load, not on demand: a sandboxed app cannot look the service up until this has published its token. -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <!-- Not root: sandboxed apps can send this requests, so a parsing bug here must not become root. -->
    <key>UserName</key><string>nobody</string>
    <key>GroupName</key><string>nobody</string>
    <key>StandardErrorPath</key><string>/Library/Lioness/log/appkitd.log</string>
    <key>StandardOutPath</key><string>/Library/Lioness/log/appkitd.log</string>
</dict></plist>
